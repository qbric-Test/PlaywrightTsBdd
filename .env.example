# ----------------------------------------------------------------------
# Application under test
# ----------------------------------------------------------------------
ENV=qa
BASE_URL=https://www.walmart.com
OLX_BASE_URL=https://www.olx.com.pk

# ----------------------------------------------------------------------
# Browser configuration
# chromium | firefox | webkit
# ----------------------------------------------------------------------
BROWSER=chromium
# OLX works headless. The legacy Walmart feature does not: it returns a
# "Robot or human?" wall on /search and /ip, so run @walmart with HEADLESS=false.
HEADLESS=true
SLOW_MO=0
CHANNEL=
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
LOCALE=en-US
TIMEZONE=America/Los_Angeles
IGNORE_HTTPS_ERRORS=true

# ----------------------------------------------------------------------
# Timeouts (milliseconds)
# ----------------------------------------------------------------------
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000
EXPECT_TIMEOUT=15000
STEP_TIMEOUT=60000

# ----------------------------------------------------------------------
# Execution
# ----------------------------------------------------------------------
PARALLEL_WORKERS=2
RETRY_COUNT=0

# ----------------------------------------------------------------------
# Artifacts: on | off | retain-on-failure
# ----------------------------------------------------------------------
SCREENSHOT=retain-on-failure
VIDEO=retain-on-failure
TRACE=retain-on-failure
ARTIFACTS_DIR=test-results
REPORTS_DIR=reports

# ----------------------------------------------------------------------
# Logging: debug | info | warn | error
# ----------------------------------------------------------------------
LOG_LEVEL=info
